# ============================================================
# TARIQAH AL-RAJ LIVE AUDIO — ENVIRONMENT CONFIGURATION
# ============================================================

# ------------------------------------------------------------
# 1. CLIENT-SIDE VARIABLES (Exposed to Vite & Capacitor WebView)
# NOTE: Only public anon keys are allowed here. NEVER put service role or Cloudflare secrets here!
# ------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-public-anon-key

# ------------------------------------------------------------
# 2. SERVER-SIDE EDGE FUNCTION VARIABLES (supabase/functions/cloudflare-sfu)
# Configured via: supabase secrets set CF_CALLS_APP_ID=... CF_CALLS_APP_TOKEN=...
# ------------------------------------------------------------
# Cloudflare Realtime Calls App ID (e.g. 0123456789abcdef)
CF_CALLS_APP_ID=your-cloudflare-calls-app-id

# Cloudflare Realtime Calls App Token (Authorization Bearer Token)
CF_CALLS_APP_TOKEN=your-cloudflare-calls-app-token

# Supabase Service Role Key (automatically provided in Supabase Edge Functions environment)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
